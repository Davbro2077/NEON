# Ключ Google Gemini API (хранится строго на сервере)
GEMINI_API_KEY="your_gemini_api_key_here"

# Опционально: принудительно задать модель (например, gemini-3.8-flash, gemini-3.6-flash или gemini-3.5-flash)
# Если не задано, сервер сам выберет первую доступную Flash-модель
GEMINI_MODEL=""

# База данных Turso (по умолчанию работает локальный файл LibSQL file:local.db,
# а для облачной Turso укажите ваш libsql://... URL и TURSO_AUTH_TOKEN)
TURSO_DATABASE_URL="file:local.db"
TURSO_AUTH_TOKEN=""
