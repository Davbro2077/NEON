# Ключ Google Gemini API (хранится строго на сервере)
# На Vercel добавьте в Settings -> Environment Variables
GEMINI_API_KEY="your_gemini_api_key_here"

# Опционально: принудительно задать модель (по умолчанию сервер использует gemini-3.5-flash)
GEMINI_MODEL=""

# Облачная база данных Turso (строго libsql://... или https://..., без file:local.db)
# На Vercel добавьте TURSO_DATABASE_URL и TURSO_AUTH_TOKEN в Settings -> Environment Variables
TURSO_DATABASE_URL="libsql://your-db-name.turso.io"
TURSO_AUTH_TOKEN="your_turso_auth_token_here"
